function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function main(): void
{
    record("before\n");

    if (true) {
        if (true) {
        } finally {
            record("inner\n");
            panic("stop in inner finalizer");
        }
    } finally {
        record("wrong outer cleanup\n");
    }
}
