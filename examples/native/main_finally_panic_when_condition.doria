function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function stop(): bool
{
    panic("stop in when condition");
    return false;
}

function main(): void
{
    record("before\n");

    string $value = when (stop()): string {
        return "wrong";
    } else {
        return "wrong";
    } finally {
        record("wrong cleanup\n");
    };
}
