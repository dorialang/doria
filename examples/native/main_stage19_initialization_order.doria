function initializeLabel(): string throws Doria\Std\Io\IoError
{
    echo "property initializer\n";
    return "ready";
}

function initializeMessage(): string throws Doria\Std\Io\IoError
{
    echo "constructor argument\n";
    return "message";
}

class Message
{
    string $label = initializeLabel();
    string $state;

    function __construct(string $text) throws Doria\Std\Io\IoError
    {
        echo "constructor ";
        echo $this->label;
        echo " ";
        echo $this->text;
        echo "\n";
        $this->state = "initialized";
    }

    function __destruct()
    {
        try {
            echo "destructor ";
            echo $this->state;
            echo "\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function main(): void
{
    let $message = new Message(initializeMessage());
}
