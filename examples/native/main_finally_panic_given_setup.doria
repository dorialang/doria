function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function stop(): void
{
    panic("stop in given setup");
}

function main(): void
{
    record("before\n");

    given {
        stop();
        true;
    } if (true) {
        record("wrong body\n");
    } finally {
        record("wrong cleanup\n");
    }
}
