function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void throws Doria\Std\Io\IoError
{
    let writable $index = 0;
    given {
        int $limit = 2;
        true;
    } while ($index < $limit) {
        $index++;
    } finally {
        record("cleanup {$index}/{$limit}\n");
    }
}
