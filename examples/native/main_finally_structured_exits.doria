function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function choose(): int throws Doria\Std\Io\IoError
{
    if (true) {
        return 42;
    } finally {
        record("return cleanup\n");
    }
    return 0;
}

function main(): void throws Doria\Std\Io\IoError
{
    echo "value {choose()}\n";
    let writable $index = 0;
    while ($index < 3) {
        $index++;
        if ($index == 1) {
            continue;
        } finally {
            record("iteration {$index}\n");
        }
        break;
    } finally {
        record("loop cleanup\n");
    }
}
