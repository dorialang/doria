class Item
{
    writable int $value = 1;

    function __destruct()
    {
        try {
            echo "drop item\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function makeReadProperty(): ?ReadonlySharedReferenceAccess<Item>
{
    let $owner = new WritableSharedReference(new Item());
    return $owner->acquireReadonlyAccess();
}

function makeWriteProperty(): ?WritableSharedReferenceAccess<Item>
{
    let $owner = new WritableSharedReference(new Item());
    return $owner->acquireWritableAccess();
}

class AccessHolder
{
    writable ?ReadonlySharedReferenceAccess<Item> $read = makeReadProperty();
    writable ?WritableSharedReferenceAccess<Item> $write = makeWriteProperty();

    function inspect(): void throws Doria\Std\Io\IoError
    {
        inspectRead($this->read);
        inspectWrite($this->write);
    }

    writable function clear(): void
    {
        $this->read = null;
        $this->write = null;
    }
}

function inspectRead(?ReadonlySharedReferenceAccess<Item> $access): void throws Doria\Std\Io\IoError
{
    if ($access != null) {
        echo "property read {$access->value}\n";
    }
}

function inspectWrite(?WritableSharedReferenceAccess<Item> $access): void throws Doria\Std\Io\IoError
{
    if ($access != null) {
        echo "property write {$access->value}\n";
    }
}

function maybeRead(
    ?WritableSharedReference<Item> $source,
): ?ReadonlySharedReferenceAccess<Item> {
    return $source?->acquireReadonlyAccess();
}

function maybeWrite(
    ?WritableSharedReference<Item> $source,
): ?WritableSharedReferenceAccess<Item> {
    return $source?->acquireWritableAccess();
}

function reacquire(
    ?WritableWeakReference<Item> $source,
): ?WritableSharedReference<Item> {
    return $source?->acquire();
}

function main(): void
{
    let writable $holder = new AccessHolder();
    $holder->inspect();
    $holder->clear();

    echo "replacement released\n";

    let $calledReadOwner = new WritableSharedReference(new Item());
    let $calledRead = maybeRead($calledReadOwner);
    if ($calledRead != null) {
        echo "called read {$calledRead->value}\n";
    }

    let $calledWriteOwner = new WritableSharedReference(new Item());
    let $calledWrite = maybeWrite($calledWriteOwner);
    echo "called write\n";

    let $discardedReadOwner = new WritableSharedReference(new Item());
    let writable $discardedReads = [maybeRead($discardedReadOwner)];
    $discardedReads->pop();
    let writable $afterDiscardedRead = $discardedReadOwner->acquireWritableAccess();
    $afterDiscardedRead->value = 2;
    echo "discarded read released {$afterDiscardedRead->value}\n";

    let $discardedWriteOwner = new WritableSharedReference(new Item());
    let writable $discardedWrites = [
        "write" => maybeWrite($discardedWriteOwner),
    ];
    $discardedWrites->remove("write");
    let $afterDiscardedWrite = $discardedWriteOwner->acquireReadonlyAccess();
    echo "discarded write released {$afterDiscardedWrite->value}\n";

    let $weakOwner = new WritableSharedReference(new Item());
    let $weak = $weakOwner->createWeakReference();
    let $calledStrong = reacquire($weak);
    echo "called strong\n";

    let $listOwner = new WritableSharedReference(new Item());
    let writable $reads = [$listOwner->acquireReadonlyAccess()];
    let $removedRead = $reads->removeAt(0);
    echo "removed read {$removedRead->value}\n";

    let $writeListOwner = new WritableSharedReference(new Item());
    let writable $writes = [$writeListOwner->acquireWritableAccess()];
    let writable $removedWrite = $writes->removeAt(0);
    $removedWrite->value = 4;
    echo "removed write {$removedWrite->value}\n";

    let $nullableListOwner = new WritableSharedReference(new Item());
    let writable $nullableReads = [maybeRead($nullableListOwner)];
    let $removedNullableRead = $nullableReads->removeAt(0);
    if ($removedNullableRead != null) {
        echo "removed nullable {$removedNullableRead->value}\n";
    }

    let $popOwner = new WritableSharedReference(new Item());
    let writable $popReads = [$popOwner->acquireReadonlyAccess()];
    let $poppedRead = $popReads->pop();
    if ($poppedRead != null) {
        echo "popped read {$poppedRead->value}\n";
    }

    let $dictionaryOwner = new WritableSharedReference(new Item());
    let writable $dictionaryWrites = [
        "write" => $dictionaryOwner->acquireWritableAccess(),
    ];
    let writable $removedDictionaryWrite = $dictionaryWrites->remove("write");
    if ($removedDictionaryWrite != null) {
        $removedDictionaryWrite->value = 6;
        echo "removed dictionary write {$removedDictionaryWrite->value}\n";
    }
}
