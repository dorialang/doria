function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function stop(): bool
{
    panic("stop in given predicate");
    return false;
}

function main(): void
{
    record("before\n");

    given {
        stop();
    } if (true) {
        record("wrong body\n");
    } finally {
        record("wrong cleanup\n");
    }
}
