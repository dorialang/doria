open class Key implements Hashable, Equatable<Key>
{
    function __construct(int $value) {}
    function hash(): uint64 { return 18446744073709551615; }
    function equals(Key $other): bool { return $this->value == $other->value; }
}

class ChildKey extends Key
{
    function __construct(override int $value) { parent::__construct($value); }
}

function key(int $value): Key { return new ChildKey($value); }

class Box { function __construct(writable int $value) {} }

function main(): void
{
    writable Dictionary<Key, ?int> $values = [key(1) => null, key(2) => 20];
    echo $values->containsKey(key(1));
    echo $values->containsKey(key(3));
    echo $values->get(key(1)) ?? -1;
    $values[key(2)] = 22;
    $values->set(key(3), 30);
    echo $values[key(2)] ?? -1;
    echo $values->remove(key(3)) ?? -1;
    $values->remove(key(1));
    foreach ($values as Key $key => ?int $value) {
        echo "{$key->value}:" . ($value ?? -1);
    }
    echo "\n";
    writable Dictionary<Key, Box> $objects = [key(1) => new Box(1)];
    foreach ($objects as Key $key => writable Box $box) { $box->value = 9; }
    echo "writable {$objects[key(1)]->value}\n";

    let $owner = new WritableSharedReference<Set<Key>>(Set::from([]));
    {
        let writable $access = $owner->acquireWritableAccess();
        $access->add(key(1));
        $access->add(key(2));
        echo "shared {$access->count}:" . $access->contains(key(2)) . "\n";
        foreach ($access as Key $entry) { echo "{$entry->value}"; }
        echo "\n";
    }
}
