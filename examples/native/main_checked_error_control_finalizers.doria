class Failure implements Error
{
    function __construct(string $message)
    {
    }
}

function fail(): void throws Failure
{
    throw new Failure("control");
}

function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function main(): void
{
    try {
        if (true) {
            fail();
        } finally {
            record("if finally\n");
        }
    } catch (Failure $error) {
        record("caught {$error->message}\n");
    }
}
