open class Failure implements Error
{
    function __construct(string $message) {}
}
class Missing extends Failure
{
    function __construct() { parent::__construct("typed"); }
}
function fail(): void throws Missing { throw new Missing(); }
function main(): void
{
    try { fail(); }
    catch (Failure $error) { echo "toThrow carrier {$error->message}\n"; }
}
