function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function stop(): bool
{
    panic("stop in do condition");
    return false;
}

function main(): void
{
    do {
        record("before\n");
    } while (stop()) finally {
        record("wrong cleanup\n");
    }
}
