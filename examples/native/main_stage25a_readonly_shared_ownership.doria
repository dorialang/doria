class Node
{
    function __construct(string $name)
    {
    }

    function __destruct()
    {
        try {
            echo "drop {$this->name}\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }

    function label(): string
    {
        return $this->name;
    }
}

function inspect(SharedReference<Node> $node): void throws Doria\Std\Io\IoError
{
    echo "inspect {$node->name}\n";
}

function marker(): int throws Doria\Std\Io\IoError
{
    echo "marker\n";
    return 7;
}

function inspectNamed(int $marker, SharedReference<Node> $node): void throws Doria\Std\Io\IoError
{
    echo "{$marker}:{$node->name}\n";
}

function makeExpiredWeak(): WeakReference<Node>
{
    let $strong = shared new Node("expired");
    return $strong->createWeakReference();
}

function makeStrong(string $name): SharedReference<Node>
{
    return shared new Node($name);
}

function makeTemporaryWeak(): WeakReference<Node>
{
    return makeStrong("temporary")->createWeakReference();
}

function main(): void
{
    let writable $current = shared new Node("old current");
    $current = shared new Node("current");
    inspect($current);

    let $expiredWeak = makeExpiredWeak();
    let $expired = $expiredWeak->acquire();
    if ($expired == null) {
        echo "expired\n";
    }

    let $temporaryWeak = makeTemporaryWeak();
    if ($temporaryWeak->acquire() == null) {
        echo "temporary expired\n";
    }
    let $fallback = $temporaryWeak->acquire() ?? shared new Node("fallback");
    inspect($fallback);

    let $chained = makeStrong("chained")->share();
    inspect($chained);
    echo makeStrong("payload")->referencedValue->label() . "\n";

    let $root = shared new Node("root");
    let $weak = $root->createWeakReference();
    List<SharedReference<Node>> $list = [$root->share()];
    SharedReference<Node>[] $array = [$root->share()];
    Dictionary<string, SharedReference<Node>> $named = [
        "root" => $root->share(),
    ];

    inspect($root);
    foreach ($list as SharedReference<Node> $item) {
        inspect($item);
    }
    inspect($list[0]);
    inspectNamed(node: $list[0], marker: marker());
    inspect($array[0]);
    if ($named->get("root") != null) {
        echo "found\n";
    }

    writable Dictionary<string, SharedReference<Node>> $replace = [
        "node" => shared new Node("old"),
    ];
    $replace->set("node", shared new Node("new"));

    let $live = $weak->acquire();
    if ($live != null) {
        inspect($live);
    }
}
