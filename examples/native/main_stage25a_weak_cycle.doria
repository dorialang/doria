class Parent
{
    writable List<WritableSharedReference<Child>> $children = [];

    function __destruct()
    {
        try {
            echo "drop parent\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

class Child
{
    function __construct(take WritableWeakReference<Parent> $parentReference)
    {
    }

    function inspectParent(): void throws Doria\Std\Io\IoError
    {
        let $parent = $this->parentReference->acquire();
        if ($parent != null) {
            echo "parent alive\n";
        }
    }

    function __destruct()
    {
        try {
            echo "drop child\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function makeExpiredParent(): WritableWeakReference<Parent> throws Doria\Std\Io\IoError
{
    let $parent = new WritableSharedReference(new Parent());
    let $externalWeak = $parent->createWeakReference();
    let $child = new WritableSharedReference(
        new Child($parent->createWeakReference()),
    );

    {
        let writable $parentAccess = $parent->acquireWritableAccess();
        $parentAccess->children->add($child->share());
    }

    let $childAccess = $child->acquireReadonlyAccess();
    $childAccess->inspectParent();
    return $externalWeak;
}

function main(): void throws Doria\Std\Io\IoError
{
    let $parent = makeExpiredParent();
    if ($parent->acquire() == null) {
        echo "parent expired\n";
    }
}
