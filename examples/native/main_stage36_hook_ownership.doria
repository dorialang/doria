class Item {
    function __construct(int $id) {}
    function __destruct() { try { echo "drop {$this->id}\n"; } catch (Error) {} }
}

interface Storage {
    writable Item $item { borrowed get; set (take Item $next); }
}
class Store implements Storage {
    writable Item $item = new Item(1) {
        borrowed get => $this->item;
        set (take Item $next) => $this->item = $next;
    }
    writable ?string $text = null { get => $this->text; set (?string $next) => $this->text = $next; }
    writable bool $flag = false { get => $this->flag; set (bool $next) => $this->flag = $next; }
    function __destruct() { try { echo "drop store\n"; } catch (Error) {} }
}
function replace(writable Storage $store, take Item $next): void { $store->item = $next; }
function main(): void {
    let writable $store = new Store();
    replace($store, new Item(2));
    $store->text = "hello";
    $store->flag = true;
    echo "{$store->item->id} " . ($store->text ?? "none") . " {$store->flag}\n";
    $store->text = null;
    echo ($store->text ?? "empty") . "\n";
}
