class Failure implements Error
{
    function __construct(string $message)
    {
    }
}

function fail(): void throws Failure
{
    throw new Failure("unused");
}

function main(): void throws Doria\Std\Io\IoError
{
    try {
        fail();
    } catch (Failure) {
        echo "handled without binding\n";
    }
}
