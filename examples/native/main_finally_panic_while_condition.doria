function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function stop(): bool
{
    panic("stop in while condition");
    return false;
}

function main(): void
{
    record("before\n");

    while (stop()) {
        record("wrong body\n");
    } finally {
        record("wrong cleanup\n");
    }
}
