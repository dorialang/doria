class Message
{
    function __construct(string $text)
    {
    }

    function __destruct()
    {
        try {
            echo "message released\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function deliver(take Message $message): void throws Doria\Std\Io\IoError
{
    echo $message->text . "\n";
}

function main(): void
{
    let $message = new Message("Welcome to Doria");
    deliver($message);
}
