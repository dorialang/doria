function record(string $message): void
{
    try { echo $message; } catch (Doria\Std\Io\IoError) {}
}

function main(): void
{
    record("before\n");

    string $value = when (true): string {
        panic("stop in when branch");
        return "wrong";
    } else {
        return "wrong";
    } finally {
        record("wrong cleanup\n");
    };
}
