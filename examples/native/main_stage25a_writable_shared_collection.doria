function update(WritableSharedReference<List<int>> $values): void
{
    let writable $access = $values->acquireWritableAccess();
    $access[0] += 9;
    $access->add(4);
    let $removed = $access->removeAt(1);
    echo "removed {$removed}\n";
}

function inspect(WritableSharedReference<List<int>> $values): void
{
    let $access = $values->acquireReadonlyAccess();
    echo "{$access[0]}:{$access->count}:{$access[1]}\n";
}

function main(): void
{
    let $values = new WritableSharedReference([1, 2, 3]);
    update($values);
    inspect($values);
}
