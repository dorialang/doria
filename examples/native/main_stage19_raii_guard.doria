class RawModeGuard
{
    function __construct(string $label) throws Doria\Std\Io\IoError
    {
        echo "enable ";
        echo $this->label;
        echo " raw mode\n";
    }

    function __destruct()
    {
        try {
            echo "restore ";
            echo $this->label;
            echo "\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function run_screen(): void throws Doria\Std\Io\IoError
{
    let $guard = new RawModeGuard("terminal");
    echo "screen work\n";
    return;
}

function main(): void
{
    run_screen();
}
