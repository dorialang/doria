class Note
{
    function __construct(string $text)
    {
    }
}

function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    given {
        let $note = new Note("ready");
        true;
    } if (true) {
        echo "body\n";
    } finally {
        record("cleanup\n");
    }
}
