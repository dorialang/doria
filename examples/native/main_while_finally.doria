function main(): void throws Doria\Std\Io\IoError
{
    let writable $index = 0;
    while ($index < 4) {
        $index++;
        if ($index == 1) {
            continue;
        }
        if ($index == 3) {
            break;
        }
        echo "step {$index}\n";
    } finally {
        echo "cleanup {$index}\n";
    }
}
