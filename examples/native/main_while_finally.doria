function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    let writable $index = 0;
    while ($index < 4) {
        $index++;
        if ($index == 1) {
            continue;
        }
        if ($index == 3) {
            break;
        }
        echo "step {$index}\n";
    } finally {
        record("cleanup {$index}\n");
    }
}
