class Box
{
    writable int $value = 1;
    function getValue(): int { return $this->value; }
    writable function increment(): void { $this->value++; }
}

function makeSharedBox(bool $present): ?SharedReference<Box>
{
    if ($present) { return shared new Box(); }
    return null;
}

function main(): void
{
    let $owner = new WritableSharedReference<List<int>>([1, 2, 3]);

    int $directCount = $owner->acquireReadonlyAccess()->count;
    {
        let writable $write = $owner->acquireWritableAccess();
        $write->add(4);
    }

    ?WritableSharedReference<List<int>> $maybeOwner = $owner->share();
    int $nullableCount =
        $maybeOwner?->acquireReadonlyAccess()?->count ?? -1;
    {
        let writable $write = $owner->acquireWritableAccess();
        $write->add(5);
    }

    if ($owner->acquireReadonlyAccess()->contains(5)) {
        echo "condition\n";
    }
    {
        let writable $write = $owner->acquireWritableAccess();
        $write->add(6);
    }

    let $boxOwner = new WritableSharedReference(new Box());
    int $boxValue = $boxOwner->acquireReadonlyAccess()->value;
    {
        let writable $write = $boxOwner->acquireWritableAccess();
        $write->value++;
    }

    echo "direct {$directCount}\n";
    echo "nullable {$nullableCount}\n";
    echo "list {$owner->acquireReadonlyAccess()->count}\n";
    echo "box {$boxValue}:{$boxOwner->acquireReadonlyAccess()->value}\n";

    ?WritableSharedReference<Box> $maybeBoxOwner = $boxOwner->share();
    int $nullableBoxValue = $maybeBoxOwner?->acquireReadonlyAccess()?->getValue() ?? -1;
    $maybeBoxOwner?->acquireWritableAccess()?->increment();
    echo "nullable box {$nullableBoxValue}:{$boxOwner->acquireReadonlyAccess()->value}\n";
    echo "shared factory " . (makeSharedBox(true)?->value ?? -1) . " " .
        (makeSharedBox(false)?->value ?? -1) . "\n";
}
