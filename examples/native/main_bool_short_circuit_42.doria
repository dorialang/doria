function left(): bool throws Doria\Std\Io\IoError
{
    echo "L";
    return false;
}

function right(): bool throws Doria\Std\Io\IoError
{
    echo "R";
    return true;
}

function main(): int
{
    bool $value = left() and right();

    if (not $value) {
        return 42;
    }

    return 0;
}
