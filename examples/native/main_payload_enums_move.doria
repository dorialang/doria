class Token
{
    function __construct(string $name)
    {
    }

    function __destruct()
    {
        try {
            echo "drop {$this->name}\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

enum LoadResult
{
    case Loaded(Token $token);
    case Empty;
}

function load(): LoadResult
{
    return LoadResult::Loaded(new Token("moved"));
}

function consume(take LoadResult $result): void throws Doria\Std\Io\IoError
{
    echo "consume\n";
}

function main(): void throws Doria\Std\Io\IoError
{
    LoadResult $result = load();
    consume($result);
    echo "done\n";
}
