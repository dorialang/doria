function checkedCondition(): bool throws Doria\Std\Io\IoError
{
    echo "condition\n";
    return true;
}

function main(): void
{
    given {
        let $prepared = 42;
        false;
    } if (checkedCondition()) {
        echo "selected {$prepared}\n";
    } else if (checkedCondition()) {
        echo "alternate\n";
    } else {
        echo "gate closed {$prepared}\n";
    }
}
