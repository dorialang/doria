function prepare(): void throws Doria\Std\Io\IoError
{
    echo "setup\n";
}

function ready(int $remaining): bool throws Doria\Std\Io\IoError
{
    echo "predicate {$remaining}\n";
    return true;
}

function main(): void
{
    given {
        prepare();
        let writable $remaining = 3;
        ready($remaining);
    } while ($remaining > 0) {
        echo "body {$remaining}\n";
        $remaining--;
        continue;
    }
}
