enum Coordinate
{
    case Origin;
    case Point(int $x, int $y);
}

enum Label
{
    case Text(string $value);
}

const Label DEFAULT_LABEL = Label::Text("default");

class LabelReader
{
    function __construct(Label $label) throws Doria\Std\Io\IoError
    {
        echo " {$label == Label::Text("constructor")}";
    }

    function matches(Label $label): bool
    {
        return $label == Label::Text("instance");
    }

    static function matchesStatic(Label $label): bool
    {
        return $label == Label::Text("static");
    }
}

function mark(string $label, int $value): int throws Doria\Std\Io\IoError
{
    echo $label;
    return $value;
}

function usesDefault(Label $label = Label::Text("default")): bool
{
    return $label == DEFAULT_LABEL;
}

function describe(?Coordinate $value = Coordinate::Origin): string
{
    if ($value == null) { return "null"; }
    if ($value == Coordinate::Origin) { return "origin"; }
    return "point";
}

function main(): void throws Doria\Std\Io\IoError
{
    Coordinate $point = Coordinate::Point(
        y: mark("y", 22),
        x: mark("x", 20),
    );
    Coordinate $copy = $point;
    Label $label = Label::Text("copy");
    Label $labelCopy = $label;

    echo " {$point == Coordinate::Point(20, 22)}";
    echo " {$copy == $point}";
    echo " {$labelCopy == Label::Text("copy")}";
    echo " {usesDefault()} {describe(null)} {describe()}\n";
    let $reader = new LabelReader(Label::Text("constructor"));
    echo " {$reader->matches(Label::Text("instance"))}";
    echo " {LabelReader::matchesStatic(Label::Text("static"))}\n";
}
