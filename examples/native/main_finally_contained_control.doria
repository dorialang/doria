function main(): void throws Doria\Std\Io\IoError
{
    if (true) {
        echo "body\n";
    } finally {
        int $choice = when (true): int {
            return 2;
        } else {
            return 0;
        };
        while ($choice > 0) {
            echo "contained {$choice}\n";
            break;
        }
    }
}
