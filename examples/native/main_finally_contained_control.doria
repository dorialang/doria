function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void throws Doria\Std\Io\IoError
{
    if (true) {
        echo "body\n";
    } finally {
        int $choice = when (true): int {
            return 2;
        } else {
            return 0;
        };
        while ($choice > 0) {
            record("contained {$choice}\n");
            break;
        }
    }
}
