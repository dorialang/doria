function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    if (true) {
        if (true) {
            echo "body\n";
        } finally {
            record("inner\n");
        }
    } finally {
        record("outer\n");
    }
}
