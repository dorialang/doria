function runtimeCount(): int throws Doria\Std\Io\IoError
{
    echo "count\n";
    return 3;
}

function fillValue(): string throws Doria\Std\Io\IoError
{
    echo "value\n";
    return "repeat";
}

function inspectWords(List<string> $words): void throws Doria\Std\Io\IoError
{
    echo "{$words->count}:{$words[1]}\n";
}

function main(): int
{
    bool[] $flags = [true; runtimeCount()];
    int[] $numbers = [42; 2];
    List<bool> $listFlags = [false; 2];
    List<int> $counts = [7; 3];
    let $defaulted = [9; 2];
    List<string> $words = [fillValue(); runtimeCount()];
    Set<int> $unique = Set::from([11; 3]);
    inspectWords(["borrowed"; runtimeCount()]);

    writable bool[] $sieve = [true; runtimeCount()];
    $sieve[1] = false;

    echo "{$flags->length}:{$flags[2]}\n";
    echo "{$numbers->length}:{$numbers[0]}:{$numbers[1]}\n";
    echo "{$listFlags->count}:{$listFlags[1]}\n";
    echo "{$counts->count}:{$counts[2]}\n";
    echo "{$defaulted->count}:{$defaulted[0]}\n";
    echo "{$words->count}:{$words[0]}:{$words[2]}\n";
    echo "{$unique->count}:{$unique->contains(11)}\n";
    echo "{$sieve->length}:{$sieve[0]}:{$sieve[1]}\n";
    return 0;
}
