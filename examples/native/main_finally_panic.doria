class Guard
{
    function __destruct()
    {
        try {
            echo "wrong destructor\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void throws Doria\Std\Io\IoError
{
    let $guard = new Guard();
    echo "before\n";

    if (true) {
        panic("stop before cleanup");
    } finally {
        record("must not run\n");
    }
}
