function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    string $value = given {
        string $label = "ready";
        true;
    } when (true): string {
        return $label;
    } else {
        return "missed";
    } finally {
        record("cleanup {$label}\n");
    };
    echo "value {$value}\n";
}
