function main(): void throws Doria\Std\Io\IoError
{
    string $value = given {
        string $label = "ready";
        true;
    } when (true): string {
        return $label;
    } else {
        return "missed";
    } finally {
        echo "cleanup {$label}\n";
    };
    echo "value {$value}\n";
}
