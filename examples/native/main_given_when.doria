function skippedCondition(): bool throws Doria\Std\Io\IoError
{
    echo "condition\n";
    return true;
}

function main(): void
{
    string $label = given {
        let $prepared = "ready";
        false;
    } when (skippedCondition()): string {
        return $prepared;
    } else when (skippedCondition()) {
        return "alternate";
    } else {
        return "fallback {$prepared}";
    };

    echo $label . "\n";
}
