class Temperature
{
    internal writable float $storedCelsius = 0.0;

    float $celsius {
        get => $this->storedCelsius;
    }

    writable float $fahrenheit {
        get => $this->storedCelsius * 9.0 / 5.0 + 32.0;
        set (float $value) => $this->storedCelsius = ($value - 32.0) * 5.0 / 9.0;
    }
}

function main(): void
{
    let writable $temperature = new Temperature();
    printf("freezing: %.1f F\n", $temperature->fahrenheit);
    $temperature->fahrenheit = 212.0;
    printf("boiling: %.1f C; %.1f F\n", $temperature->celsius, $temperature->fahrenheit);
}
