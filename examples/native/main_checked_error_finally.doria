class Failure implements Error
{
    function __construct(string $message)
    {
    }
}

function fail(): void throws Failure
{
    throw new Failure("failure");
}

function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    try {
        fail();
    } catch (Failure) {
        record("caught\n");
    } finally {
        record("finally\n");
    }
}
