#!/usr/bin/env php
<?php

declare(strict_types=1);

// Development launcher for `doriac` (cargo run from source).
//
// Two build choices make the from-source `doriac` behave like a real toolchain:
//
//   bundled-runtime         remains enabled so build.rs compiles doria-rt from
//                           source and publishes the fresh archive path used by
//                           native links. This is Cargo's default feature set.
//
//   --features llvm-backend added only when an LLVM 18 toolchain is present, so
//                           `doriac compile --release` (the LLVM profile) works.
//                           Without LLVM the launcher still builds (Cranelift
//                           only) and `--release` reports the usual clear error.
//
$repositoryRoot = dirname(__DIR__);

$environment = getenv();
if (!is_array($environment)) {
    $environment = [];
}
$environment['CLICOLOR_FORCE'] = '1';
if (!isset($environment['CARGO_TARGET_DIR']) || $environment['CARGO_TARGET_DIR'] === '') {
    $environment['CARGO_TARGET_DIR'] = development_target_directory($repositoryRoot);
}

$features = [];
$llvmPrefix = detect_llvm18_prefix();
if ($llvmPrefix !== null) {
    $features[] = '--features';
    $features[] = 'llvm-backend';
    $environment['LLVM_SYS_181_PREFIX'] = $llvmPrefix;
}

$command = [
    'cargo',
    'run',
    '--color=always',
    ...$features,
    '--manifest-path',
    $repositoryRoot . DIRECTORY_SEPARATOR . 'Cargo.toml',
    '--package',
    'doriac',
    '--',
    ...array_slice($argv, 1),
];

$descriptors = [
    0 => ['file', 'php://stdin', 'r'],
    1 => ['file', 'php://stdout', 'w'],
    2 => ['file', 'php://stderr', 'w'],
];

$process = proc_open($command, $descriptors, $pipes, null, $environment);
if (!is_resource($process)) {
    fwrite(STDERR, "doriac development launcher could not start Cargo.\n");
    exit(1);
}

exit(proc_close($process));

/**
 * Locate an LLVM 18 installation for the `llvm-backend` feature: an explicit
 * LLVM_SYS_181_PREFIX first, then the usual Homebrew/Linux locations, verified
 * by asking llvm-config for a matching major version. Returns null when none is
 * found, so the launcher degrades to a Cranelift-only build.
 */
function detect_llvm18_prefix(): ?string
{
    $fromEnv = getenv('LLVM_SYS_181_PREFIX');
    if (is_string($fromEnv) && $fromEnv !== '' && llvm_config_is_18($fromEnv)) {
        return $fromEnv;
    }

    $candidates = [
        '/opt/homebrew/opt/llvm@18',
        '/usr/local/opt/llvm@18',
        '/usr/lib/llvm-18',
        '/opt/homebrew/opt/llvm',
        '/usr/local/opt/llvm',
    ];
    foreach ($candidates as $prefix) {
        if (llvm_config_is_18($prefix)) {
            return $prefix;
        }
    }

    return null;
}

function llvm_config_is_18(string $prefix): bool
{
    $llvmConfig = $prefix . '/bin/llvm-config';
    if (!is_file($llvmConfig)) {
        return false;
    }

    $process = proc_open(
        [$llvmConfig, '--version'],
        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes
    );
    if (!is_resource($process)) {
        return false;
    }
    $version = stream_get_contents($pipes[1]) ?: '';
    fclose($pipes[1]);
    fclose($pipes[2]);
    proc_close($process);

    return str_starts_with(trim($version), '18');
}

function development_target_directory(string $repositoryRoot): string
{
    $home = getenv(PHP_OS_FAMILY === 'Windows' ? 'USERPROFILE' : 'HOME');
    $home = is_string($home) && $home !== '' ? $home : sys_get_temp_dir();
    $cacheRoot = match (PHP_OS_FAMILY) {
        'Windows' => getenv('LOCALAPPDATA') ?: $home . DIRECTORY_SEPARATOR . 'AppData'
            . DIRECTORY_SEPARATOR . 'Local',
        'Darwin' => $home . DIRECTORY_SEPARATOR . 'Library' . DIRECTORY_SEPARATOR . 'Caches',
        default => getenv('XDG_CACHE_HOME') ?: $home . DIRECTORY_SEPARATOR . '.cache',
    };

    return $cacheRoot
        . DIRECTORY_SEPARATOR
        . 'Doria'
        . DIRECTORY_SEPARATOR
        . 'source-launcher'
        . DIRECTORY_SEPARATOR
        . substr(hash('sha256', $repositoryRoot), 0, 16);
}
