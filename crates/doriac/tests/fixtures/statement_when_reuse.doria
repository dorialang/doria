class Trace { static writable string $log = ""; }
class Product {
    function __construct(int $value) {}
    function __destruct(): void { Trace::log = Trace::log . $this->value . ","; }
}
class Failure implements Error { function __construct(string $message) {} }
function conditionOrFail(bool $fail): bool throws Failure {
    if ($fail) { throw new Failure("predicate"); }
    return true;
}
function reused(): int {
    let writable $saved = new Product(0);
    let writable $index = 0;
    while ($index < 2) {
        try {
            let $next = when (conditionOrFail($index == 1)): Product {
                return new Product(5);
            } else {
                return new Product(99);
            } finally {
                Trace::log = Trace::log . "u,";
            };
            $saved = $next;
        } catch (Failure) {
            Trace::log = Trace::log . "c,";
        }
        $index++;
    }
    return $saved->value;
}
function main(): void {
    let $reused = reused();
    echo "{$reused}|{Trace::log}\n";
}
