enum Shape
{
    case Circle(float $radius);
    case Rect(float $width, float $height);
}

function area(Shape $shape): float
{
    return match ($shape) {
        Shape::Circle($radius) => 3.14159265 * $radius * $radius,
        Shape::Rect($width, $height) => $width * $height,
    };
}

function main(): void
{
}
