class Guard
{
    function __construct(string $name)
    {
    }

    function __destruct()
    {
        try {
            echo "drop {$this->name}\n";
        } catch (Doria\Std\Io\IoError) {
        }
    }
}

class Counter
{
    writable int $value = 40;

    writable function advance(): int
    {
        let writable $increment = function (): int with (writable $this) {
            $this->value += 1;
            return $this->value;
        };
        return $increment();
    }
}

function inspect(mixed $value): void
{
}

function consume(take mixed $value): void
{
}

function boxed(): mixed
{
    return fn() => 13;
}

function main(): void
{
    (function(): int)[] $fixed = [fn() => 10];
    writable SortedDictionary<string, function(): int> $sorted =
        SortedDictionary::from([]);
    $sorted->set("value", fn() => 11);
    writable Deque<function(): int> $queue = Deque::from([]);
    $queue->pushBack(fn() => 12);
    function(): int $front = $queue->popFront() ?? fn() => 0;
    let writable $counter = new Counter();
    echo "{$fixed[0]()} {$sorted["value"]()} {$front()} {$counter->advance()}\n";

    let $callable = fn() => 42;
    inspect($callable);
    echo "borrow {$callable()}\n";
    consume(fn() => 1);
    mixed $returned = boxed();

    let $first = new Guard("first");
    let $second = new Guard("second");
    writable mixed $stored = fn() with (take $first) => $first->name;
    $stored = fn() with (take $second) => $second->name;
    echo "body\n";
}
