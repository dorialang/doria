class Box
{
    function __construct(int $value)
    {
    }

    function reader(): function(): int
    {
        return fn() with ($this) => $this->value;
    }
}

function bind(int $value): function(): int
{
    return fn() with ($value) => $value;
}

function main(): void
{
    let $value = 40;
    let $readParameter = bind($value);
    let $box = new Box(2);
    let $readReceiver = $box->reader();
    int $left = $readParameter();
    int $right = $readReceiver();
    echo "{$left + $right}\n";
}
