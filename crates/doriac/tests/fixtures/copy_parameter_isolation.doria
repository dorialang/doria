enum Packet { case Number(int $count); case Empty; }
function read(Packet $value): int {
    return match ($value) { Packet::Number($count) => $count, Packet::Empty => -1, };
}
function replace(writable Packet $value): int { $value = Packet::Number(13); return read($value); }
function inspectTake(take Packet $value): int { return read($value); }
function replaceGeneric<T>(writable T $value, take T $replacement): void { $value = $replacement; }
function replaceOptional(writable ?Packet $value): bool { $value = Packet::Number(7); return $value != null; }
function replaceDefault(writable Packet $value = Packet::Number(3)): int { $value = Packet::Number(17); return read($value); }
function append(writable List<int> $values): void { $values->add(9); }
interface Editor { function replace(writable Packet $value): int; }
open class Base implements Editor {
    open function replace(writable Packet $value): int { $value = Packet::Number(21); return read($value); }
}
class Derived extends Base {
    override function replace(writable Packet $value): int { $value = Packet::Number(22); return read($value); }
    static function replaceStatic(writable Packet $value): int { $value = Packet::Number(23); return read($value); }
