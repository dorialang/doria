    if ($editor->replace($value) != 22 || read($value) != 4) { panic("virtual Copy parameter"); }
    if (erased($editor, $value) != 22 || read($value) != 4) { panic("erased Copy parameter"); }
    if (Derived::replaceStatic(value: $value) != 23 || read($value) != 4) { panic("named static Copy parameter"); }
    let $owner = new Owner($value);
    if (read($owner->value) != 4 || read($value) != 4) { panic("promoted Copy parameter"); }
    ?Packet $absent = null;
    if (!replaceOptional($absent) || $absent != null) { panic("nullable Copy parameter"); }
    if (replaceDefault() != 17) { panic("default Copy parameter"); }
    let $callback = function(writable Packet $argument): int { $argument = Packet::Number(24); return read($argument); };
    if ($callback($value) != 24 || read($value) != 24) { panic("writable callback borrow ABI"); }
    let writable $number = 1;
    let $scalar = function(writable int $argument): int { $argument = 10; return $argument; };
    if ($scalar($number) != 10 || $number != 10) { panic("writable scalar callback borrow ABI"); }
    writable List<int> $values = [1];
