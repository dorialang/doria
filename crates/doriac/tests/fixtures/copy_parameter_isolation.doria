class Owner {
    function __construct(writable Packet $value) { $value = Packet::Number(30); }
}
function erased(Editor $editor, writable Packet $value): int { return $editor->replace($value); }
function main(): void {
    let writable $value = Packet::Number(4);
    if (replace($value) != 13 || read($value) != 4) { panic("free Copy parameter"); }
    if (inspectTake($value) != 4 || read($value) != 4) { panic("take Copy parameter"); }
    replaceGeneric($value, Packet::Number(15));
