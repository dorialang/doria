function invoke(function(): int $callback): int
{
    return $callback();
}

function inspectWritable(take function writable(): int $callback): void throws Doria\Std\Io\IoError
{
    writable mixed $value = $callback;
    if ($value is function writable(): int) {
        echo "writable\n";
    }
    if ($value is function(): int) {
        echo "wrong readonly\n";
    }
}

function main(): void
{
    mixed $value = fn() => 42;
    if ($value is function(): int) {
        echo "guard {$value()} {invoke($value)}\n";
    }

    mixed $other = fn(int $input) => $input;
    if ($other is function(): int) {
        echo "wrong signature\n";
    } else {
        echo "exact signature\n";
    }

    ?mixed $nullable = fn() => 9;
    if ($nullable is function(): int) {
        echo "nullable {$nullable()}\n";
    }

    function writable(): int $writable = fn() => 41;
    inspectWritable($writable);
}
