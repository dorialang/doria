function record(string $message): void
{
    try {
        echo $message;
    } catch (Doria\Std\Io\IoError) {
    }
}

function main(): void
{
    int $value = given {
        true;
    } when (true): int {
        return 42;
    } else {
        return 0;
    } finally {
        record("cleanup\n");
    };
}
