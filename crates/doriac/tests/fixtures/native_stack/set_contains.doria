// Set::contains in a loop body. The set holds the even values below 128, and
// the loop queries 0..15, so exactly half of the queries hit.
function main(List<string> $args): void
{
    let $n = Int::parse($args[0]) ?? 0;
    writable Set<int> $values = Set::from([]);
    for (let writable $index = 0; $index < 64; $index++) {
        $values->add($index * 2);
    }
    let writable $hits = 0;
    for (let writable $index = 0; $index < $n; $index++) {
        if ($values->contains($index % 16)) {
            $hits = ($hits + 1) % 1000003;
        }
    }
    echo "{$hits}\n";
}
