namespace Doria\Tui\Rendering;

use Doria\Tui\Rendering\WindowStyles;

/**
 * Represents a window in the terminal user interface.
 *
 * @version 1.0.0
 * @since 1.0.0
 */
class Window
{
    const int DEFAULT_WIDTH = 120;
    const int DEFAULT_HEIGHT = 30;

    internal writable List<string> $content = [];
    writable WindowStyles $styles;

    /**
     * Creates a new Window instance.
     *
     * @param writable string $title The title of the window.
     * @param internal int $width The width of the window (default: 120).
     * @param internal int $height The height of the window (default: 30).
     */
    function __construct(
        writable string $title,
        internal int $width = self::DEFAULT_WIDTH,
        internal int $height = self::DEFAULT_HEIGHT,
    )
    {
        $this->styles = new WindowStyles();
    }

    /**
     * Renders the window content to the terminal.
     *
     * @return void
     */
    function render(): void
    {}
}